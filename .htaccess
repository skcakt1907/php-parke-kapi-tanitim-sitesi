# Elite Parke — temiz URL + güvenlik

# Dizin listelemeyi kapat
Options -Indexes

# --- Temiz URL yönlendirmesi ---
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Var olan dosya veya klasörler doğrudan sunulsun (assets, gonder.php, resimler...)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Ürün detay:  /urun/celik-kapi
  RewriteRule ^urun/([^/]+)/?$ index.php?sayfa=urun&u=$1 [L,QSA]

  # Sayfalar:  /urunler /hakkimizda /referanslar /iletisim /anasayfa
  RewriteRule ^(anasayfa|urunler|hakkimizda|referanslar|iletisim|gizlilik)/?$ index.php?sayfa=$1 [L,QSA]

  # Gizlilik politikası için okunaklı alternatif adres
  RewriteRule ^gizlilik-politikasi/?$ index.php?sayfa=gizlilik [L,QSA]
</IfModule>

# Hassas dosyalara doğrudan web erişimini engelle (.sql, .json, .txt, .md, .log, .ini)
<FilesMatch "\.(sql|json|md|log|ini|txt)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# DB bağlantı dosyasına doğrudan HTTP erişimi engelle (include ile çalışmaya devam eder)
<Files "baglan.php">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>
